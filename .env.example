# Copy to .env and fill in (do not commit .env).
# Apify: https://console.apify.com/account/integrations

APIFY_TOKEN=

# Optional: if set, clients must send header X-RapidAPI-Proxy-Secret with this value
# (RapidAPI proxy verification).
RAPIDAPI_PROXY_SECRET=

# Optional: override default Store actors (username/actor-name) without editing catalog.py
# APIFY_ACTOR_META_AD_LIBRARY=
# APIFY_ACTOR_INSTAGRAM=
# APIFY_ACTOR_WHATSAPP=
# APIFY_ACTOR_GOOGLE_NEWS=
# APIFY_ACTOR_AMAZON=
# APIFY_ACTOR_GOOGLE_PLACES=

# One-off: scripts/create_render_service.py (never commit real keys)
# RENDER_API_KEY=
# RENDER_OWNER_ID=

# Live Apify integration tests (slow); default pytest skips these
# RUN_LIVE_SCRAPER_TESTS=1
